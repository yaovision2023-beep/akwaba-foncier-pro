# Sanity - sanity.io/manage → project settings
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Only needed locally to run scripts/migrate-parcels.mjs (server-side write access, never exposed to the browser)
SANITY_API_WRITE_TOKEN=your-write-token

# Formspree - formspree.io → your form → Setup page (form ID from the endpoint URL, not secret)
NEXT_PUBLIC_FORMSPREE_FORM_ID=your-formspree-form-id
